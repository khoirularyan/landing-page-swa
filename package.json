{
  "name": "swa-digital-solusindo-landing",
  "version": "1.0.0",
  "description": "Landing page for SWA Digital Solusindo - Enterprise Custom ERP & Tech Solutions",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "node prisma/seed.js",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset --force && node prisma/seed.js",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "keywords": [
    "landing-page",
    "swa-digital-solusindo",
    "nodejs",
    "express",
    "prisma",
    "postgresql"
  ],
  "author": "SWA Digital Solusindo",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "multer": "^2.4.0",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "prisma": "^6.0.0"
  }
}
